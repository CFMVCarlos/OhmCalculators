@@ -0,0 +1,71 @@
+from pydantic import BaseModel, model_validator
+from typing import Optional
+
+
+class VoltageDividerRequest(BaseModel):
+    vin: Optional[float] = None
+    vout: Optional[float] = None
+    r1: Optional[float] = None
+    r2: Optional[float] = None
+
+    @model_validator(mode="after")
+    def check_inputs(self):
+        provided = sum(
+            [
+                self.vin is not None,
+                self.vout is not None,
+                self.r1 is not None,
+                self.r2 is not None,
+            ]
+        )
+        if provided < 3:
+            raise ValueError("Insufficient data. Provide exactly three parameters.")
+        if provided > 3:
+            raise ValueError(
+                "Too many arguments provided. Provide at most three parameters."
+            )
+
+        # Validation rules based on calculations
+        if self.r1 is None and self.vin == self.vout:
+            raise ValueError("Vin and Vout cannot be equal when calculating R1.")
+        if self.r2 is None and self.vin == self.vout:
+            raise ValueError("Vin and Vout cannot be equal when calculating R2.")
+        if self.vin is None and self.r2 == 0:
+            raise ValueError("Resistance R2 cannot be zero when calculating Vin.")
+        if self.vout is None and self.r1 == 0 and self.r2 == 0:
+            raise ValueError("Total resistance (R1 + R2) cannot be zero.")
+
+        if self.r1 is not None and self.r1 < 0:
+            raise ValueError("Resistance R1 cannot be negative.")
+        if self.r2 is not None and self.r2 < 0:
+            raise ValueError("Resistance R2 cannot be negative.")
+
+        return self
+
+
+class TargetResistanceRequest(BaseModel):
+    target_value: float
+
+    @model_validator(mode="after")
+    def check_target(self):
+        if self.target_value <= 0:
+            raise ValueError("Target resistance must be greater than 0.")
+        return self
+
+
+class ResistorDivRequest(BaseModel):
+    vin: float
+    vout: float
+    maximum_current: float
+
+    @model_validator(mode="after")
+    def check_voltages(self):
+        if self.vin <= 0:
+            raise ValueError("Vin must be greater than 0.")
+        if self.vout < 0:
+            raise ValueError("Vout cannot be negative.")
+        if self.maximum_current <= 0:
+            raise ValueError("Maximum current must be greater than 0.")
+        if self.vout >= self.vin:
+            raise ValueError("Vout must be less than Vin in a passive voltage divider.")
+        return self
diff --git a/src/routes/api.py b/src/routes/api.py
new file mode 100644
index 0000000..c8244bc
--- /dev/null
+++ b/src/routes/api.py
@@ -0,0 +1,83 @@
+from fastapi import APIRouter, HTTPException
+from src.models.requests import (
+    VoltageDividerRequest,
+    TargetResistanceRequest,
+    ResistorDivRequest,
+)
+from src.services.calculator import (
+    calculate_voltage_divider,
+    calculate_best_parallel,
+    calculate_divider_resistors,
+)
+from lib.common import convert_to_shorthand
+
+router = APIRouter()
+
+
+@router.post("/calculate-missing")
+async def calculate_missing(request: VoltageDividerRequest):
+    try:
+        result = calculate_voltage_divider(
+            vin=request.vin, vout=request.vout, r1=request.r1, r2=request.r2
+        )
+        # Find which parameter was calculated
+        missing_param = None
+        if request.vin is None:
+            missing_param = "vin"
+        elif request.vout is None:
+            missing_param = "vout"
+        elif request.r1 is None:
+            missing_param = "r1"
+        elif request.r2 is None:
+            missing_param = "r2"
+
+        return {
+            "status": "success",
+            "data": {"calculated_parameter": missing_param, "value": result},
+        }
+    except ValueError as e:
+        raise HTTPException(status_code=400, detail=str(e))
+    except Exception as e:
+        raise HTTPException(status_code=500, detail="An unexpected error occurred.")
+
+
+@router.post("/best-parallel")
+async def best_parallel(request: TargetResistanceRequest):
+    try:
+        r1, r2, error = calculate_best_parallel(request.target_value)
+        return {
+            "status": "success",
+            "data": {
+                "r1": r1,
+                "r1_shorthand": convert_to_shorthand(r1),
+                "r2": r2,
+                "r2_shorthand": convert_to_shorthand(r2),
+                "error": error,
+            },
+        }
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=str(e))
+
+
+@router.post("/divider-resistors")
+async def divider_resistors(request: ResistorDivRequest):
+    try:
+        r1, r2, error, current = calculate_divider_resistors(
+            request.vin, request.vout, request.maximum_current
+        )
+        return {
+            "status": "success",
+            "data": {
+                "r1": r1,
+                "r1_shorthand": convert_to_shorthand(r1),
+                "r2": r2,
+                "r2_shorthand": convert_to_shorthand(r2),
+                "error": error,
+                "current_amps": current,
+                "current_ma": current * 1000,
+            },
+        }
+    except ValueError as e:
+        raise HTTPException(status_code=400, detail=str(e))
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=str(e))
